# Names and placeholders only: never a real value. Copy to .env for local runs.
# The gateway has no secrets: routes live in nginx/routes/.

# Anchored by the gateway (^...$). Shell 4200 and the remotes of ADR-025
# (auth 4201, booking 4202, catalog 4203, concessions 4204, ticketing 4205).
APP_GATEWAY_CORS_ORIGIN_REGEX=http://localhost:(4200|4201|4202|4203|4204|4205)

# Base URL (scheme, host, port; no path) of each domain service, resolved by Docker DNS
# on the shared `platform` network (service names; ports 8081-8085 of deployment.md).
APP_GATEWAY_AUTH_UPSTREAM=http://auth-api:8081
