# Names and placeholders only: never a real value. Copy to .env for local runs.
# The gateway has no secrets: routes live in nginx/routes/.

# Anchored by the gateway (^...$). Shell 4200 and the remotes of ADR-025
# (auth 4201, booking 4202, catalog 4203, concessions 4204, ticketing 4205).
APP_GATEWAY_CORS_ORIGIN_REGEX=http://localhost:(4200|4201|4202|4203|4204|4205)

# Base URL (scheme, host, port; no path) of each domain service, resolved by Docker DNS
# on the shared `platform` network (service names; ports 8081-8086 of deployment.md and ADR-066).
APP_GATEWAY_AUTH_UPSTREAM=http://auth-api:8081
# Catalog is HTTPS-only (ADR-067): the gateway refuses to start with an http:// URL here.
APP_GATEWAY_CATALOG_UPSTREAM=https://catalog-api:8082
APP_GATEWAY_BOOKING_UPSTREAM=http://booking-api:8083
APP_GATEWAY_CONCESSIONS_UPSTREAM=http://concessions-api:8085
APP_GATEWAY_WORKFLOW_UPSTREAM=http://workflow:8086

# CA certificate (public) that verifies Catalog. In the container it is always /run/tls/ca.crt; compose mounts
# it read-only from the host file below (defined by csp-infra-postgres, one CA per environment: dev, qa, main).
CATALOG_TLS_CA_FILE=/run/tls/ca.crt
CATALOG_TLS_CA_HOST_FILE=<path to the ca.crt of the environment>
